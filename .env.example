# Optional DATA PROVIDER credentials only. ChatGPT / Codex supplies reasoning.
# No PATENT_LLM_BASE_URL, PATENT_LLM_MODEL, Ollama or OpenAI API key is required.
EPO_OPS_CLIENT_ID=
EPO_OPS_CLIENT_SECRET=
# Free anonymous OpenAlex access is supported; key raises provider usage budget.
OPENALEX_API_KEY=
# Optional Crossref polite-pool contact email; use your own verified address.
PATENT_CONTACT_EMAIL=
# 每个 MCP 进程必须绑定唯一研发项目
PATENT_MCP_PROJECT_ID=PM80
# OpenAlex 匿名有额度限制；大规模前沿检索使用免费或授权 API Key
OPENALEX_API_KEY=

# Ubuntu 26.04 LTS Docker deployment.
PATENT_IMAGE=ghcr.io/lqepoch/mechanical_patent:main
PATENT_DATA_DIR=/srv/mechanical-patent/data

# 学术数据源密钥，请通过本机环境或密钥管理器注入，不提交真实凭证。
SEMANTIC_SCHOLAR_API_KEY=
NCBI_API_KEY=
UNPAYWALL_EMAIL=
# 商业许可来源：除密钥外还要求 --allow-paid-paper-apis。
CORE_API_KEY=
LENS_API_TOKEN=
